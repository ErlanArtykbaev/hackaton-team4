# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values (CLAUDE.md §6).

# Hotel sandbox base URL.
SANDBOX_BASE_URL=https://hackathon2026.tyngo.com
# Team key from the organizers, sent as X-API-KEY.
SANDBOX_API_KEY=
# POS access code from the organizers.
SANDBOX_ACCESS_CODE=
# POS employee PIN the backend logs in with (integration employee INT01 for guest-facing actions).
SANDBOX_PIN=
# PIN of a bartender from the organizers' handout, for scripts/pos-order.mjs (demo step 4b).
POS_BARTENDER_PIN=
# Device id sent with POS calls.
SANDBOX_DEVICE_ID=team4-backend
# Poll the sandbox events feed (true/false).
SANDBOX_EVENTS_ENABLED=true
# Requests per second from this backend. The key allows 10 for the whole team:
# 2 on each developer laptop with 4 people, 3 with 3 people, 8 on the demo laptop.
SANDBOX_RATE_LIMIT=8

# Language model, used once the organizers name the provider.
LLM_API_KEY=
LLM_MODEL=
